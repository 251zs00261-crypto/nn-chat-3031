doctype html
html(lang="ja")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title StudyLog - 一行進捗・学習記録ボード
    link(
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      crossorigin="anonymous"
    )
    link(
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    )
    link(rel="stylesheet" href="/style.css")
    script.
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme) {
        document.documentElement.setAttribute('data-bs-theme', savedTheme);
      }
  body.container.overflow-scroll
    nav.navbar.fixed-top.bg-primary
      div.container-fluid
        h1.text-light.navbar-brand.mx-auto
          i.bi-journal-check.me-2
          span StudyLog
        div.dropdown
          button.btn.btn-outline-light.dropdown-toggle(type="button" data-bs-toggle="dropdown" aria-expanded="false")
            i.bi-palette-fill
          ul.dropdown-menu.dropdown-menu-end
            li
              button.dropdown-item(type="button" onclick="setTheme('light')") ライトモード
            li
              button.dropdown-item(type="button" onclick="setTheme('dark')") ダークモード

    div.my-3
      p.text-muted.text-center 今日の学習・作業の進捗を一行で手軽に記録しましょう。

    div.card.my-3
      div.card-body
        form(method="post" action="/posts" id="post-form").row.g-3
          div.col-12
            textarea(name="content" rows="2" placeholder="例: 19:30 Dockerのボリュームマウントを理解した / 次はPrismaの確認 (Ctrl+Enterで送信)").form-control
            input(type="hidden" name="oneTimeToken" value=oneTimeToken)
          div.col-12
            button(type="submit").btn.btn-primary.float-end
              i.bi-send.me-1
              span 記録する

    div.my-3
      h2.h5.mb-3
        i.bi-clock-history.me-2
        span 進捗タイムライン
      each post in posts
        div.card.my-3
          div.card-body
            div.d-flex.justify-content-between
              h5.card-title #{post.postedBy}
                if post.postedBy === 'admin'
                  i.bi-patch-check-fill.ms-1
              - const tooltipTitle = `<small>${post.absoluteCreatedAt}</small>`
              small.card-text.float-end(data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" title=tooltipTitle) #{post.relativeCreatedAt}
            p.card-text.lead #{post.content}
          - const isDeletable = (user === post.postedBy || user === 'admin')
          if isDeletable
            div.card-footer.d-flex.justify-content-end
              form(method="post" action="/posts/delete")
                input(type="hidden" name="id" value=post.id)
                input(type="hidden" name="oneTimeToken" value=oneTimeToken)
                button(type="submit").btn.btn-outline-danger.btn-sm
                  i.bi-trash

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      crossorigin="anonymous"
    )
    script(src="/nn-chat.js")
    script.
      function setTheme(theme) {
        document.documentElement.setAttribute('data-bs-theme', theme);
        localStorage.setItem('theme', theme);
        document.cookie = 'theme=' + theme + '; path=/; max-age=2592000';
      }